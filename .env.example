READNOTE_PROFILE_NAME=Local Reader

READNOTE_TRANSLATION_PROVIDER=deepseek
READNOTE_TRANSLATION_MODEL=deepseek-v4-flash
# Paste your DeepSeek/OpenAI/MiniMax API key:
READNOTE_TRANSLATION_API_KEY=

# Absolute path to your Obsidian Markdown notebook (leave empty if not using Obsidian):
READNOTE_OBSIDIAN_PATH=

# Notion Internal Integration Token (leave empty if not using Notion):
READNOTE_NOTION_TOKEN=
# Notion page ID from your reading notes page URL (32 hex chars):
READNOTE_NOTION_PAGE_ID=

# Optional fallback providers — only needed if you switch translation provider:
# OPENAI_API_KEY=
# MINIMAX_API_KEY=
